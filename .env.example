DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=

# App version (CalVer YYYY.MM.DD-N), shown on the home page
CAST_VERSION=

# Database — SQLite by default (file lives in the mounted ./data dir)
DB_ENGINE=django.db.backends.sqlite3
DB_DATABASE=/data/db.sqlite3
# For Postgres instead: set these and uncomment the `db` service in docker-compose.yml
# DB_ENGINE=django.db.backends.postgresql
# DB_USER=
# DB_PASSWORD=
# DB_DATABASE=
# DB_HOST=db
# DB_PORT=5432

CACHE_BACKEND=
CACHE_LOCATION=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=

# External databases
LAST_DB={"host":"","port":8123,"username":"","password":""}
FORCED_PHOTOMETRY_DB={"host":"","port":5432,"username":"","password":"","CAST_user_id":0}

# Astro-COLIBRI
ASTRO_COLIBRI_API_URL=https://astro-colibri.science
ASTRO_COLIBRI_USERNAME=last
ASTRO_COLIBRI_PASSWORD=

# Large file bootstrap
LARGE_FILES_MANIFEST_PATH=/app/large_files_manifest.json

# TNS public catalog (offline matching)
TNS_API_LOOKUPS_ENABLED=False
TNS_PUBLIC_OBJECTS_URL=https://www.wis-tns.org/system/files/tns_public_objects/tns_public_objects.csv.zip
TNS_PUBLIC_OBJECTS_USER_AGENT='tns_marker{"tns_id":,"type":"","name":""}'
TNS_PUBLIC_OBJECTS_ZIP_PATH=/app/large_files/tns/tns_public_objects.csv.zip
TNS_PUBLIC_OBJECTS_CSV_PATH=/app/large_files/tns/tns_public_objects.csv
TNS_PUBLIC_OBJECTS_MATCH_RADIUS_ARCSEC=3.0

TNS_API_KEY=
TNS_BOT_ID=
TNS_BOT_NAME=

# ATLAS forced photometry
ATLAS_API_TOKEN=

# LASAIR (ZTF forced photometry)
LASAIR_API_KEY=
